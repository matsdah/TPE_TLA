// Múltiples saltos incondicionales (goto) entre diferentes escenas.

character "Narr" as narr color "#FFFFFF";

scene "Scene_A" {
    narr "Scene A."
    goto "Scene_B";
}

scene "Scene_B" {
    narr "Scene B."
    goto "Scene_C";
}

scene "Scene_C" {
    narr "Scene C."
    goto "Scene_D";
}

scene "Scene_D" {
    narr "Final scene."
    end;
}